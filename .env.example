# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sessão — string aleatória longa (ex.: openssl rand -hex 32)
SESSION_SECRET=

# Resend — resend.com/api-keys
RESEND_API_KEY=
# Domínio de teste do Resend por padrão. Trocar por um domínio próprio verificado
# antes de vender pra clientes reais (só assim é possível enviar pra qualquer destinatário).
RESEND_FROM_EMAIL=onboarding@resend.dev

# URL pública do app (usada nos links dos e-mails)
APP_URL=http://localhost:3000

# Segredo da própria URL do webhook: /api/webhook/cakto?token=ESTE_VALOR
WEBHOOK_TOKEN=

# Secret retornado pela Cakto ao criar o webhook (webhook_create) — usado pra
# validar a assinatura X-Cakto-Signature de cada entrega.
CAKTO_WEBHOOK_SECRET=
